<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Health data never travels in the clear. HTTPS only, system trust anchors only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
